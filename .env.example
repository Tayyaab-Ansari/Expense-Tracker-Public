# Runtime environment: development | production
APP_ENV=development
# Python logging level
LOG_LEVEL=INFO
# SQLAlchemy URL; SQLite locally, Postgres in production
DATABASE_URL=sqlite:///./data/expense.db
# Timezone used for business dates
TIMEZONE=Asia/Karachi

# Comma separated phone numbers allowed to use the bot
ALLOWED_NUMBERS=
# Display name of the owner
OWNER_NAME=

# WhatsApp Cloud API permanent access token
WA_ACCESS_TOKEN=
# WhatsApp phone number id used to send messages
WA_PHONE_NUMBER_ID=
# WhatsApp business account id
WA_BUSINESS_ACCOUNT_ID=
# Token echoed back during webhook verification
WA_VERIFY_TOKEN=
# Meta app secret used to validate webhook signatures
WA_APP_SECRET=
# Graph API version used for all WhatsApp calls
GRAPH_API_VERSION=v23.0

# OpenRouter API key
OPENROUTER_API_KEY=
# Primary model for tool calling
LLM_MODEL=google/gemini-2.5-flash-lite
# Fallback model if the primary one fails
LLM_FALLBACK_MODEL=google/gemini-3.1-flash-lite
# Model used to transcribe voice notes
TRANSCRIBE_MODEL=google/gemini-2.5-flash-lite
# Number of past conversation turns sent to the LLM
HISTORY_TURNS=6
